# Copy this file to .env.local for local overrides, or set VITE_API_URL
# as an environment variable in your hosting platform (Vercel/Netlify).
#
# Leave BLANK for local development — the Vite dev server proxy in
# vite.config.js already forwards /api requests to localhost:8000.
#
# When deployed, set this to your live backend URL, e.g.:
# VITE_API_URL=https://dbd-backend.onrender.com
VITE_API_URL=
